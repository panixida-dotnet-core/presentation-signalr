<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

        <AssemblyName>PANiXiDA.Core.Presentation.SignalR</AssemblyName>

        <PackageId>PANiXiDA.Core.Presentation.SignalR</PackageId>
        <Description>Reusable ASP.NET Core SignalR integration with access token handling and Redis backplane support.</Description>
        <PackageTags>PANiXiDA;AspNetCore;SignalR;Realtime;WebSockets;Redis;Authentication</PackageTags>

        <RepositoryUrl>https://github.com/panixida-dotnet-core/presentation-signalr</RepositoryUrl>
        <PackageProjectUrl>https://github.com/panixida-dotnet-core/presentation-signalr</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PANiXiDA.Core.Presentation.SignalR.UnitTests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Nerdbank.MessagePack.SignalR" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
        <PackageReference Include="PANiXiDA.Core.ResultPattern" />
        <PackageReference Include="PANiXiDA.Core.ApiDocumentation" />
        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../PANiXiDA.Core.Presentation.SignalR.Generators/PANiXiDA.Core.Presentation.SignalR.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <None Include="../PANiXiDA.Core.Presentation.SignalR.Generators/bin/$(Configuration)/netstandard2.0/PANiXiDA.Core.Presentation.SignalR.Generators.dll"
              Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
</Project>
