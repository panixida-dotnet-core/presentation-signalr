<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>

        <AssemblyName>PANiXiDA.Core.Presentation.SignalR</AssemblyName>

        <PackageId>PANiXiDA.Core.Presentation.SignalR</PackageId>
        <Description>Reusable ASP.NET Core SignalR integration with access token handling and Redis backplane support.</Description>
        <PackageTags>PANiXiDA;AspNetCore;SignalR;Realtime;WebSockets;Redis;Authentication</PackageTags>

        <RepositoryUrl>https://github.com/panixida-dotnet-core/presentation-signalr</RepositoryUrl>
        <PackageProjectUrl>https://github.com/panixida-dotnet-core/presentation-signalr</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
        <PackageReference Include="Nerdbank.GitVersioning">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
</Project>
